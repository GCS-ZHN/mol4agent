{
  "name": "@gcszhn/mol4agent-core",
  "version": "0.3.0",
  "type": "module",
  "description": "Harness-neutral Mol* viewer engine: bytes + explicit format in, commands out.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "import": "./lib/protocol.js",
      "default": "./lib/protocol.js"
    },
    "./parse": {
      "types": "./lib/parse/index.d.ts",
      "import": "./lib/parse/index.js",
      "default": "./lib/parse/index.js"
    },
    "./sources": {
      "types": "./lib/sources.d.ts",
      "import": "./lib/sources.js",
      "default": "./lib/sources.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "import": "./lib/react.js",
      "default": "./lib/react.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs"
  },
  "peerDependencies": {
    "molstar": "^5.13.1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.12",
    "molstar": "5.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GCS-ZHN/mol4agent.git",
    "directory": "packages/core"
  }
}
