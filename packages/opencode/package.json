{
  "name": "@gcszhn/mol4agent-opencode",
  "version": "0.4.0",
  "type": "module",
  "description": "OpenCode 2 adapter for mol4agent: an in-harness Mol* viewer panel with agent-operable mol_* tools.",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./gui-experimental": "./dist/gui.cjs",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @gcszhn/mol4agent-core build && node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0 <3.0.0"
  },
  "dependencies": {
    "@gcszhn/mol4agent-core": "workspace:>=0.4.0 <1.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.10",
    "molstar": "5.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.3"
  }
}
