{
  "name": "@gcszhn/mol4agent-opencode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode 2 adapter for mol4agent: an in-harness Mol* viewer panel with agent-operable mol_* tools.",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./gui-experimental": "./dist/gui.cjs",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gcszhn/mol4agent-core": "workspace:*"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.10",
    "molstar": "5.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
