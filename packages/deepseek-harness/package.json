{
  "name": "@gcszhn/mol4agent-deepseekharness",
  "version": "0.4.0",
  "type": "module",
  "description": "DeepSeek Harness adapter: molecular document preview, agent-driven viewer commands, and PNG capture.",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "pnpm --filter @gcszhn/mol4agent-core build && node --experimental-strip-types --test test/*.test.ts"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "react": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.2-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-resources": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.3",
    "@gcszhn/mol4agent-core": "workspace:>=0.3.0 <1.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.10",
    "molstar": "5.13.1",
    "react": "18.3.1",
    "typescript": "^5.7.3",
    "zod": "4.6.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GCS-ZHN/mol4agent.git",
    "directory": "packages/deepseek-harness"
  }
}
