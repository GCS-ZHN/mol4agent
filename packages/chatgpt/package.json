{
  "name": "@gcszhn/mol4agent-chatgpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChatGPT/Codex plugin: an MCP App molecular viewer with agent-operable mol_* tools.",
  "license": "MIT",
  "bin": {
    "mol4agent-mcp": "./lib/server.js"
  },
  "exports": {
    ".": "./lib/server.js"
  },
  "files": [
    "lib",
    "skills",
    ".codex-plugin",
    ".mcp.json",
    "icon.svg",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "install-local": "node scripts/install-local.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gcszhn/mol4agent-core": "workspace:*",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.10",
    "molstar": "5.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.3"
  }
}
